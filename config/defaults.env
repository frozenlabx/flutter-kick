# shellcheck shell=bash
# shellcheck disable=SC2034
# ==============================================================================
# mobile-toolchain-setup: Default Configuration
# Single source of truth for recommended versions, URLs, and install paths
# ==============================================================================

# Recommended Toolchain Versions
JDK_VERSION="17"
ANDROID_API="36"
BUILD_TOOLS_VERSION="36.0.0"
NDK_VERSION="27.2.12479018"       # Android NDK r27c (Current LTS)
CMAKE_VERSION="3.22.1"            # Recommended CMake for Android Gradle Plugin
GRADLE_VERSION="8.11.1"           # Current stable Gradle release
FLUTTER_CHANNEL="stable"          # Flutter stable channel
MACOS_IOS_TOOLS="yes"             # Xcode CLI tools and CocoaPods on macOS

# Fallback URLs for Android SDK Command-line Tools (v13.0 / 11076708)
CMDLINE_TOOLS_VERSION="11076708"
ANDROID_REPO_XML_URL="https://dl.google.com/android/repository/repository2-3.xml"
CMDLINE_TOOLS_URL_LINUX="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
CMDLINE_TOOLS_URL_MAC="https://dl.google.com/android/repository/commandlinetools-mac-11076708_latest.zip"
CMDLINE_TOOLS_URL_WIN="https://dl.google.com/android/repository/commandlinetools-win-11076708_latest.zip"

# Pre-flight Requirements
MIN_DISK_SPACE_GB=15

# Centralized Logging
DEFAULT_LOG_FILE="${HOME}/.mobile-toolchain-setup.log"

# Default Installation Target Directories
DEFAULT_ANDROID_HOME_LINUX="${HOME}/Android/Sdk"
DEFAULT_ANDROID_HOME_MAC="${HOME}/Library/Android/sdk"
DEFAULT_ANDROID_HOME_WIN="${USERPROFILE:-}\AppData\Local\Android\Sdk"
DEFAULT_FLUTTER_HOME="${HOME}/development/flutter"
DEFAULT_FLUTTER_HOME_WIN="${USERPROFILE:-}\development\flutter"
DEFAULT_GRADLE_INSTALL_DIR="${HOME}/.local/share/gradle"
DEFAULT_GRADLE_INSTALL_DIR_WIN="${USERPROFILE:-}\.local\share\gradle"
DEFAULT_GRADLE_USER_HOME="${HOME}/.gradle"
DEFAULT_JDK_INSTALL_DIR="${HOME}/.local/share/jdks"
DEFAULT_JDK_INSTALL_DIR_WIN="${USERPROFILE:-}\.local\share\jdks"
